#!/usr/bin/env raku
#| Operators.md — documented operators / forms not yet implemented
#
# Convention: wrap assertions in `todo` so failure is expected until the feature
# lands. When a todo starts passing, remove `todo` and move the case into the
# matching section file under t/spec/Operators/.
use Test;
use lib 'lib';
use MONKEY-SEE-NO-EVAL;

use Qwiratry::Query::Slang;

plan 1;

sub slang-compiles(Str $code --> Bool) {
	so try {
		EVAL "use Qwiratry::Query::Slang;\n$code;\nTrue";
		True;
	}
}

subtest '§2 / §3 I/O aliases ⮣ and ⮧' => {
	plan 2;
	todo 'NYI: parse alias ⮣ (Operators.md §2 / §3)';
	ok slang-compiles(q[{ my $x = '{"a":1}' ⮣ 'JSONdemo'; True }]),
		'parse alias ⮣ is available';
	todo 'NYI: render alias ⮧ (Operators.md §2 / §3)';
	ok slang-compiles(q[{ my $x = %(a => 1) ⮧ 'JSONdemo'; True }]),
		'render alias ⮧ is available';
}

done-testing;
