#!/usr/bin/env raku
#| Operators.md §3 — I/O and transformation operators (⮳ ↱ ↴ ⮷)
use Test;
use lib 'lib';

use Qwiratry::Format;
use Qwiratry::Format::JSONdemo;
use Qwiratry::Query::Slang;

plan 5;

my $tmpdir = 't/tmp'.IO;
$tmpdir.mkdir unless $tmpdir.d;

subtest '§3 pipeline: source → parse → select → render → destination' => {
	plan 3;

	my $input = $tmpdir.child("spec-io-in-{$*PID}.json");
	my $output = $tmpdir.child("spec-io-out-{$*PID}.json");
	$input.spurt('[{"name":"alpha","status":"active"},{"name":"beta","status":"inactive"}]');

	my $result = (⮳ $input.Str ↱ 'JSONdemo' σ -> $_ { $_<status> eq 'active' } ↴ 'JSONdemo' ⮷ $output.Str);
	ok $output.e, 'destination file was written';
	ok $result.defined, 'pipeline returns rendered content';

	my $parsed = Qwiratry::Format.make(:type<Parse>, :format<JSONdemo>).parse-walkable($output.slurp);
	my @rows = $parsed ~~ Positional ?? $parsed.list !! ($parsed,);
	is @rows.elems, 1, 'pipeline filtered to active rows only';

	$input.unlink if $input.e;
	$output.unlink if $output.e;
}

subtest '§3 parse + query without destination returns filtered data' => {
	plan 1;

	my $input = $tmpdir.child("spec-io-query-{$*PID}.json");
	$input.spurt('[{"score":1},{"score":5},{"score":3}]');

	my $result = (⮳ $input.Str ↱ 'JSONdemo') σ -> $_ { $_<score> >= 3 };
	my @rows = $result ~~ Seq | List | Array ?? $result.list !! ($result,);
	is @rows.map(*<score>).sort, (3, 5), 'parsed selection returns matching rows';

	$input.unlink if $input.e;
}

subtest '§3 query-ast preserves raw I/O operator pipeline nodes' => {
	plan 3;

	use Qwiratry::Operator::IO;
	use Qwiratry::Query::Slang;

	my $query = query-ast({ ⮳ 'input.json' ↱ 'JSONdemo' ↴ 'JSONdemo' });

	ok $query ~~ RenderOperator, 'query-ast returns the render operator node';
	ok $query.subject ~~ ParseOperator, 'render subject is parse operator';
	ok $query.subject.subject ~~ SourceOperator, 'parse subject is source operator';
}

subtest '§3 parse slurps IO::Handle subjects' => {
	plan 2;

	my $input = $tmpdir.child("spec-io-handle-{$*PID}.json");
	$input.spurt('{"name":"from-handle"}');
	my $fh = $input.open(:r);
	my $parsed = $fh ↱ 'JSONdemo';
	ok $fh.opened, 'parse leaves the handle open';
	is-deeply $parsed, { name => 'from-handle' }, 'parse reads handle contents';
	$fh.close;
	$input.unlink if $input.e;
}

subtest '§3 parse prefers IO::Handle subject over a different origin handle' => {
	plan 1;

	use Qwiratry::Operator::Capability;
	use Qwiratry::Operator::IO;

	my $from-subject = $tmpdir.child("spec-io-subject-{$*PID}.json");
	my $from-origin = $tmpdir.child("spec-io-origin-{$*PID}.json");
	$from-subject.spurt('{"name":"from-subject"}');
	$from-origin.spurt('{"name":"from-origin"}');

	my $subject-fh = $from-subject.open(:r);
	my $origin-fh = $from-origin.open(:r);
	my $op = ParseOperator.new(:subject($subject-fh), :format<JSONdemo>);
	my $parsed = execute($op, :origin($origin-fh));

	is-deeply $parsed, { name => 'from-subject' },
		'execute-input reads subject, not the origin handle';

	$subject-fh.close;
	$origin-fh.close;
	$from-subject.unlink if $from-subject.e;
	$from-origin.unlink if $from-origin.e;
}

done-testing;

